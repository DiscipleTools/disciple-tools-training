msgctxt "Training Status field description"
msgid "New training added to the system"
msgstr "Mafunzo mapya yaliongezwa kwenye mfumo"

#: post-type/module-base.php:168
msgctxt "Training Status label"
msgid "Proposed"
msgstr "Imependekezwa"

#: post-type/module-base.php:169
msgctxt "Training Status field description"
msgid "This training has been proposed and is in initial conversations"
msgstr "Mafunzo haya yamependekezwa na ni katika mazungumzo ya mwanzo"

#: post-type/module-base.php:173
msgctxt "Training Status label"
msgid "Scheduled"
msgstr "Imepangwa"

#: post-type/module-base.php:174
msgctxt "Training Status field description"
msgid "This training is confirmed, on the calendar."
msgstr "Mafunzo haya yamethibitishwa, kwenye kalenda."

#: post-type/module-base.php:178
msgctxt "Training Status label"
msgid "In Progress"
msgstr "Inaendelea"

#: post-type/module-base.php:179
msgctxt "Training Status field description"
msgid "This training is confirmed, on the calendar, or currently active."
msgstr "Mafunzo haya yamethibitishwa, kwenye kalenda, au kwa sasa inatumika."

#: post-type/module-base.php:183
msgctxt "Training Status label"
msgid "Complete"
msgstr "Kukamilisha"

#: post-type/module-base.php:184
msgctxt "Training Status field description"
msgid "This training has successfully completed"
msgstr "Mafunzo haya yamekamilishwa vyema"

#: post-type/module-base.php:188
msgctxt "Training Status label"
msgid "Paused"
msgstr "Imesitishwa"

#: post-type/module-base.php:189
msgctxt "Training Status field description"
msgid ""
"This contact is currently on hold. It has potential of getting scheduled in "
"the future."
msgstr ""
"Anwani hii kwa sasa imesimama. Ina uwezo wa kupata ratiba katika siku zijazo."

#: post-type/module-base.php:193
msgctxt "Training Status label"
msgid "Closed"
msgstr "Imefungwa"

#: post-type/module-base.php:194
msgctxt "Training Status field description"
msgid "This training is no longer going to happen."
msgstr "Mafunzo haya hayatatokea tena."

#: post-type/module-base.php:202
msgid "Assigned To"
msgstr "Imekabidhiwa Kwa"

#: post-type/module-base.php:203
msgid ""
"Select the main person who is responsible for reporting on this training."
msgstr "Chagua mtu mkuu anayehusika na kuripoti juu ya mafunzo haya."

#: post-type/module-base.php:210
msgid "Training Coach / Church Planter"
msgstr "Mkufunzi wa Mafunzo / Mpanda Kanisa"

#: post-type/module-base.php:211
msgctxt "Optional Documentation"
msgid ""
"The person who planted and/or is coaching this training. Only one person can "
"be assigned to a training while multiple people can be coaches / church "
"planters of this training."
msgstr ""
"Mtu aliyepanda na / au anafundisha mafunzo haya. Mtu mmoja tu ndiye "
"anayeweza kupewa mafunzo wakati watu wengi wanaweza kuwa makocha / wapanda "
"kanisa wa mafunzo haya."

#: post-type/module-base.php:223
msgid "Requires Update"
msgstr "Inahitaji Sasisho"

#: post-type/module-base.php:229
msgid "Video Link"
msgstr "Kiungo cha Video"

#: post-type/module-base.php:230
msgctxt "Optional Documentation"
msgid "Link to video chat service"
msgstr "Unganisha na huduma ya gumzo la video"

